rules_version = '2';
// نبض الأسرّة — صلاحيات قاعدة البيانات
// غيّر sammag9519@gmail.com لإيميل مدير النظام (نفس اللي في config.js)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in ['sammag9519@gmail.com']; }
    function member() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myHid() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hid; }

    match /hospitals/{hid} {
      allow read: if isAdmin() || (member() && myHid() == hid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (member() && myHid() == hid && request.resource.data.id == hid);
    }
    match /log/{id} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || member()) && request.resource.data.by == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow write: if isAdmin();
    }
  }
}
